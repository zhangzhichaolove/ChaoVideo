<resources>

    <!-- Base application theme. -->
    <style name="BaseAppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="buttonStyle">@style/Widget.AppButton</item>
        <item name="android:buttonStyle">@style/Widget.AppButton</item>
        <item name="buttonBarButtonStyle">@style/Widget.AppButton.Text</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.AppButton.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.AppButton.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.AppButton.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.AppButton.Text</item>
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!--actionBar高度-->
        <item name="android:actionBarSize">50dp</item>
        <!--返回键颜色-->
        <item name="colorControlNormal">@android:color/white</item>
    </style>

    <style name="AppTheme" parent="BaseAppTheme">
        <item name="android:navigationBarColor">@color/colorAccent</item>
        <item name="android:colorControlHighlight">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoWindowBackground">
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="Widget.CardContent" parent="android:Widget">
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">24dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ChaoVideoCircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="small_tv_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="common_tv_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="both_match_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="lwrap_hmatch_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="both_wrap_style">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Scoped diagnostic palette: readable controls without changing other screens. -->
    <style name="AppTheme.Diagnostics" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/diagnostic_action</item>
        <item name="colorControlNormal">?android:attr/textColorSecondary</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
    </style>

    <!-- One button system for XML, programmatic actions and dialogs; keep 48dp touch targets. -->
    <style name="Widget.AppButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_tonal</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/button_foreground_states</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Widget.AppButton.Primary" parent="Widget.AppButton">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_foreground_states</item>
    </style>
    <style name="Widget.AppButton.Text" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/button_foreground_states</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
